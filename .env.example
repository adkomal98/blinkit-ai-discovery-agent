# Optional: enable Claude-powered summarisation and tone control.
# The app works fully WITHOUT these (deterministic mode). When set, the Claude key
# is used ONLY in server-side API routes and is never exposed to the browser.

USE_AI=false
ANTHROPIC_API_KEY=your-claude-api-key
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# The address the generated email draft is addressed to (yourself / an alias).
WEEKLY_NOTE_RECIPIENT=you@example.com
